# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://learnograph:password@localhost:5432/learnograph

# ── LLM — TokenRouter (OpenAI-compatible, routes to 300+ models) ──────────────
# Get your key at https://www.tokenrouter.com
LLM_API_KEY=your_tokenrouter_api_key_here
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=anthropic/claude-sonnet-5

# ── mem0 ─────────────────────────────────────────────────────────────────────
MEM0_API_KEY=your_mem0_api_key_here
MEM0_USER_ID=user_001

# ── Rtrvr.ai ──────────────────────────────────────────────────────────────────
RTRVR_API_KEY=your_rtrvr_api_key_here

# ── RocketRide — pipeline orchestration (optional for local dev) ──────────────
# Leave empty to use in-process asyncio queues instead
ROCKETRIDE_API_KEY=your_rocketride_api_key_here
ROCKETRIDE_URI=https://cloud.rocketride.ai

# ── ElevenLabs (used in Next.js frontend only) ───────────────────────────────
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=your_voice_id_here

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
