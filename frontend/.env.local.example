NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=your_voice_id_here

# WebSocket URL — change to wss://your-backend.onrender.com/ws in production
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Backend base URL — used by next.config.mjs to proxy /api/* requests
# Change to https://your-backend.onrender.com in production
BACKEND_URL=http://localhost:8000
